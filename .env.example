# --- Servidor ---
PORT=4000
# URL pública de este backend (se usa para armar los links de PDFs en modo local)
PUBLIC_URL=http://localhost:4000
# URL(s) del front permitidas por CORS, separadas por coma
FRONTEND_URL=http://localhost:5173

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=portal_docente
DB_SSL=false

# --- Auth ---
JWT_SECRET=cambiar-por-un-texto-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# --- Almacenamiento de PDFs: local | cloudinary ---
# local: guarda en ./uploads (solo desarrollo; Render lo borra en cada deploy)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portal-docente/leyes

# --- Admins (los crea `npm run seed` o `npm run seed:admins`) ---
ADMIN1_NOMBRE=
ADMIN1_EMAIL=
ADMIN1_PASSWORD=
ADMIN2_NOMBRE=
ADMIN2_EMAIL=
ADMIN2_PASSWORD=
ADMIN3_NOMBRE=
ADMIN3_EMAIL=
ADMIN3_PASSWORD=
